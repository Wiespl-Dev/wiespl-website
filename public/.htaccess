# Apache config for the new site's own folder on HostGator: public_html/wiespl-new/
#
# Routing (which requests come here) is done by the rules pasted at the top of
# public_html/.htaccess — see hosting/public_html-htaccess-rules.txt.
# Turning the rewrite engine off here stops those parent rules running again inside
# this folder, so requests can never loop.
RewriteEngine Off

# Cache images and built files for a year (their names change when they change); never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
