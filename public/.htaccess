# Apache config for wiespl.com on HostGator.

RewriteEngine On

# Always use https://
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old site pages (about.html, services.html ...) → new pages, so old links and Google results keep working
RewriteRule ^index\.html$ / [L,R=301]
RewriteRule ^about\.html$ /about [L,R=301]
RewriteRule ^digital-or\.html$ /digital-or [L,R=301]
RewriteRule ^services\.html$ /services [L,R=301]
RewriteRule ^contact\.html$ /contact [L,R=301]
RewriteRule ^(expo|app-demo)\.html$ / [L,R=301]

# Single-page app: any path that isn't a real file opens index.html, and React shows the right page
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]

# Cache images and built files for a year (their names change when they change); never cache index.html
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|jpg|jpeg|png|webp|svg|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml
</IfModule>
